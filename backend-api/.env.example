# ENOL SALESFORZE - Server & Database Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database Connection (PostgreSQL 16 + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enol_salesforze
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=enol_salesforze
