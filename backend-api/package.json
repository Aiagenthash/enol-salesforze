{
  "name": "enol-salesforze-api",
  "version": "1.0.0",
  "description": "Enterprise Field Force Automation (FFA) & Territory Management REST API for Automotive Lubricant Sales",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "generate:docs": "tsx src/scripts/generate-openapi.ts",
    "test": "tsx src/tests/api.test.ts"
  },
  "keywords": [
    "field-force-automation",
    "sales-force",
    "lubricants",
    "postgis",
    "fastify",
    "rest-api",
    "webhooks"
  ],
  "author": "Lead Backend Architect",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.6",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "typescript": "^5.5.4",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "pino-pretty": "^11.2.1",
    "tsx": "^4.16.2"
  }
